# Telegram User API (Telethon, https://my.telegram.org)
TG_API_ID=12345678
TG_API_HASH=your_api_hash_here

# scripts/login.py 실행 후 얻는 값
TG_SESSION_STRING=

# Telegram Bot API (@BotFather)
BOT_TOKEN=123456:ABC-DEF...

# scripts/get_chat_id.py 실행 후 얻는 값 (본인 계정 chat_id)
BOT_CHAT_ID=

# Anthropic API (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# 모델 (필요 시 변경: claude-sonnet-4-6)
MODEL=claude-haiku-4-5-20251001

# 중복 판정 임계값 (0~1, 높을수록 엄격)
DEDUPE_THRESHOLD=0.82

# 타임존
TZ=Asia/Seoul

